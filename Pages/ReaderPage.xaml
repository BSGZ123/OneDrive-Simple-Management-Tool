<Page x:Class="OneDrive_Simple_Management_Tool.Pages.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Uid="Reader_Back" Click="BackClicked"><SymbolIcon Symbol="Back" /></Button>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <CommandBar Grid.Column="2" DefaultLabelPosition="Collapsed" Background="Transparent">
                <AppBarButton x:Uid="Reader_Contents" Icon="Bullets" Click="ContentsClicked" />
                <AppBarButton x:Uid="Reader_Settings" Icon="Setting" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                                <StackPanel Width="260" Spacing="10">
                                    <NumberBox x:Uid="Reader_FontSize" Minimum="12" Maximum="40" Value="{x:Bind ViewModel.FontSize, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsReflowableReady, Mode=OneWay}" SpinButtonPlacementMode="Compact" />
                                    <NumberBox x:Uid="Reader_LineHeight" Minimum="1" Maximum="2.5" SmallChange="0.1" Value="{x:Bind ViewModel.LineHeight, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsReflowableReady, Mode=OneWay}" SpinButtonPlacementMode="Compact" />
                                    <NumberBox x:Uid="Reader_Width" Minimum="320" Maximum="1400" SmallChange="40" Value="{x:Bind ViewModel.ReadingWidth, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsReflowableReady, Mode=OneWay}" SpinButtonPlacementMode="Compact" />
                                    <ComboBox x:Uid="Reader_Theme" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsReflowableReady, Mode=OneWay}">
                                        <ComboBoxItem x:Uid="Reader_Light" /><ComboBoxItem x:Uid="Reader_Dark" /><ComboBoxItem x:Uid="Reader_Sepia" />
                                    </ComboBox>
                                    <ComboBox x:Uid="Reader_Flow" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.FlowIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsReflowableReady, Mode=OneWay}">
                                        <ComboBoxItem x:Uid="Reader_Paginated" /><ComboBoxItem x:Uid="Reader_Scrolled" />
                                    </ComboBox>
                                    <ComboBox x:Uid="Reader_Zoom" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.ZoomIndex, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsFixedReady, Mode=OneWay}">
                                        <ComboBoxItem x:Uid="Reader_FitPage" /><ComboBoxItem x:Uid="Reader_FitWidth" />
                                    </ComboBox>
                                    <Button x:Uid="Reader_Apply" Command="{x:Bind ViewModel.ApplySettingsCommand}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
        </Grid>
        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}" IsClosable="False" Severity="Warning" Message="{x:Bind ViewModel.Notice, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button x:Uid="Reader_SaveOptions" IsEnabled="{x:Bind ViewModel.SaveFailed, Mode=OneWay}">
                    <Button.Flyout><MenuFlyout>
                        <MenuFlyoutItem x:Uid="Reader_RetrySave" Command="{x:Bind ViewModel.RetrySaveCommand}" />
                        <MenuFlyoutItem x:Uid="Reader_RestoreBackup" Click="RestoreBackupClicked" />
                        <MenuFlyoutItem x:Uid="Reader_Rebuild" Click="RebuildClicked" />
                    </MenuFlyout></Button.Flyout>
                </Button>
            </InfoBar.ActionButton>
        </InfoBar>
        <SplitView x:Name="ReaderSplit" Grid.Row="2" DisplayMode="Overlay" OpenPaneLength="260" IsPaneOpen="False" PaneBackground="{ThemeResource LayerFillColorDefaultBrush}">
            <SplitView.Pane>
                <Grid Padding="8" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock x:Uid="Reader_TocTitle" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="8" />
                    <TreeView x:Name="ContentsTree" Grid.Row="1" SelectionMode="Single" ItemInvoked="TocInvoked" />
                </Grid>
            </SplitView.Pane>
            <Grid>
                <Grid x:Name="WebHost" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460" Padding="16" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460" Padding="16" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" TextWrapping="Wrap" />
                    <Button x:Uid="Reader_Retry" Command="{x:Bind ViewModel.RetryCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </SplitView>
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Uid="Reader_Previous" Command="{x:Bind ViewModel.PreviousCommand}"><SymbolIcon Symbol="Previous" /></Button>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Progress, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Button x:Uid="Reader_Next" Grid.Column="2" Command="{x:Bind ViewModel.NextCommand}"><SymbolIcon Symbol="Next" /></Button>
        </Grid>
    </Grid>
</Page>
