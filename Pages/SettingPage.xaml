<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneDrive_Simple_Management_Tool.Pages.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    xmlns:localControls="using:OneDrive_Simple_Management_Tool.Controls"
    Background="Transparent">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Padding="24,20,24,32" Spacing="12" MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock x:Uid="SettingPage_Title" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Uid="SettingPage_AppearanceTitle" FontWeight="SemiBold" Margin="0,8,0,0" />
            <controls:SettingsCard x:Name="ThemeCard" x:Uid="SettingPage_AppTheme">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeMode" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" MinWidth="160"
                          AutomationProperties.Name="{Binding Header, ElementName=ThemeCard}">
                    <ComboBoxItem x:Uid="SettingPage_Theme_Default" />
                    <ComboBoxItem x:Uid="SettingPage_Theme_Light" />
                    <ComboBoxItem x:Uid="SettingPage_Theme_Dark" />
                </ComboBox>
            </controls:SettingsCard>
            <controls:SettingsCard x:Name="MaterialCard" x:Uid="Settings_Material">
                <controls:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F4;" /></controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="MaterialMode" SelectedIndex="{Binding MaterialIndex, Mode=TwoWay}" MinWidth="160"
                          AutomationProperties.Name="{Binding Header, ElementName=MaterialCard}">
                    <ComboBoxItem x:Uid="Settings_Material_None" />
                    <ComboBoxItem Content="Mica" />
                    <ComboBoxItem Content="Mica Alt" />
                    <ComboBoxItem Content="Acrylic" />
                </ComboBox>
            </controls:SettingsCard>
            <TextBlock Text="{Binding MaterialNotice}" TextWrapping="Wrap"
                       Visibility="{Binding HasMaterialNotice, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="{Binding SaveStatus}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding HasSaveStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
            <InfoBar IsOpen="{Binding HasError}" Severity="Warning" IsClosable="False" Message="{Binding ErrorMessage}">
                <InfoBar.ActionButton>
                    <Button x:Uid="Settings_RetrySave" Command="{Binding RetrySaveCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock x:Uid="Reader_CacheTitle" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock x:Uid="Reader_CacheDescription" TextWrapping="Wrap" />
            <Button x:Name="ClearReaderCacheButton" x:Uid="Reader_ClearCache" Click="ClearReaderCache" />
            <TextBlock x:Name="ReaderCacheStatus" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Uid="Diagnostics_Title" FontWeight="SemiBold" Margin="0,12,0,0" />
            <TextBlock x:Uid="Diagnostics_Description" TextWrapping="Wrap" />
            <localControls:WrapPanel>
                <Button x:Uid="Diagnostics_Start" Click="StartDiagnostics" Margin="0,0,8,8" />
                <Button x:Uid="Diagnostics_Stop" Click="StopDiagnostics" Margin="0,0,8,8" />
                <Button x:Uid="Diagnostics_Copy" Click="CopyDiagnostics" Margin="0,0,0,8" />
            </localControls:WrapPanel>
            <TextBlock x:Name="DiagnosticsStatus" TextWrapping="Wrap" Visibility="Collapsed" />

            <TextBlock x:Uid="SettingPage_AboutTitle" FontWeight="SemiBold" Margin="0,12,0,0" />
            <controls:SettingsExpander x:Uid="Settings_About">
                <controls:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE946;" /></controls:SettingsExpander.HeaderIcon>
                <TextBlock Text="{Binding Version}" IsTextSelectionEnabled="True" />
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard x:Uid="Settings_Source">
                        <HyperlinkButton x:Uid="Settings_SourceLink"
                                         NavigateUri="https://github.com/BSGZ123/OneDrive-Simple-Management-Tool" />
                    </controls:SettingsCard>
                    <controls:SettingsCard x:Uid="Settings_Release">
                        <HyperlinkButton x:Uid="Settings_ReleaseLink"
                                         NavigateUri="https://github.com/BSGZ123/OneDrive-Simple-Management-Tool/releases/latest" />
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
