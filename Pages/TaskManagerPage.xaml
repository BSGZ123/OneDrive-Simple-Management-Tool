<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneDrive_Simple_Management_Tool.Pages.TaskManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OneDrive_Simple_Management_Tool.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:viewmodels="using:OneDrive_Simple_Management_Tool.ViewModels" 
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    d:DataContext="{d:DesignInstance Type=viewmodels:TaskManagerViewModel}"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">



    <!--传输任务管理页面，两个标签页，分别为上传与下载-->
    <Grid>
        <Grid.Resources>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:BoolToObjectConverter x:Key="BoolToObjectConverter" TrueValue="Collapsed" FalseValue="Visible" />
            <converters:FileSizeToFriendlyStringConverter x:Key="FileSizeToFriendlyStringConverter" />

            <!--下载任务页数据模板-->
            <DataTemplate x:Key="DownloadTaskTemplate" x:DataType="viewmodels:DownloadTaskViewModel">
                <Grid Margin="0 10 0 10">
                    <!--Grid组件的上下文菜单，提供右键功能-->
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="TaskManagerPage_Resume" Command="{Binding ResumeDownloadCommand}"/>
                            <MenuFlyoutItem x:Uid="TaskManagerPage_Retry" Command="{Binding RetryDownloadCommand}"/>
                            <MenuFlyoutItem x:Uid="TaskManagerPage_Pause" Command="{Binding PauseDownloadCommand}"/>
                            <MenuFlyoutItem x:Uid="TaskManagerPage_Remove" Command="{Binding CancelTaskCommand}"/>
                            <MenuFlyoutItem x:Uid="TaskManagerPage_OpenFolder" Command="{Binding OpenFolderCommand}"/>
                        </MenuFlyout>
                    </Grid.ContextFlyout>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <!--下载条目面板-->
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding Name}" FontSize="20" Margin="0 5 0 5" />
                        <!--下载进度条-->
                        <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" ShowError="{Binding HasFailed}" ShowPaused="{Binding IsPaused}" Visibility="{Binding Completed, Converter={StaticResource BoolToObjectConverter}}" />
                        
                        <!--下载参数-->
                        <TextBlock>
                            <!--下载字节-->
                            <Run Text="{Binding DownloadedBytes,Converter={StaticResource FileSizeToFriendlyStringConverter}}" />
                            <Run Text=" / " />
                            <!--下载总字节-->
                            <Run Text="{Binding TotalBytes,Converter={StaticResource FileSizeToFriendlyStringConverter}}" />
                            <Run Text=" " />
                            <!--下载速度-->
                            <Run Text="{Binding DownloadSpeed,Converter={StaticResource FileSizeToFriendlyStringConverter}}" />
                            <Run Text="/s" />
                        </TextBlock>

                        <!--任务状态与可恢复的失败原因-->
                        <TextBlock Text="{Binding StatusText}" />
                        <TextBlock Text="{Binding ErrorMessage}" Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibilityConverter}}" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" />
                    </StackPanel>

                    <!--功能按钮，如下载 暂停 取消-->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10 0 10 0">
                        <Button x:Uid="Download_PauseButton" Margin="0 0 10 0" Visibility="{Binding CanPause,Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding PauseDownloadCommand}">
                            <FontIcon Glyph="&#xE769;" FontSize="10" />
                        </Button>

                        <Button x:Uid="Download_ResumeButton" Margin="0 0 10 0" Visibility="{Binding CanResume,Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding ResumeDownloadCommand}">
                            <FontIcon Glyph="&#xE768;" FontSize="10" />
                        </Button>

                        <Button x:Uid="Download_RetryButton" Margin="0 0 10 0" Visibility="{Binding CanRetry,Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding RetryDownloadCommand}">
                            <FontIcon Glyph="&#xE72C;" FontSize="10" />
                        </Button>
                        <Button x:Uid="Download_RemoveButton" Command="{Binding CancelTaskCommand}">
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </Button>
                    </StackPanel>
                    
                </Grid>
            </DataTemplate>

            <!--上传任务页数据模板-->
            <DataTemplate x:Key="UploadTaskTemplate" x:DataType="viewmodels:UploadTaskViewModel">
                <Grid Margin="0 10 0 10">
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="TaskManagerPage_Resume" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <!--上传进度-->
                    <StackPanel Orientation="Vertical">
                        
                        <TextBlock Text="{Binding Name}" FontSize="20" Margin="0 5 0 5" />
                        <ProgressBar Value="{Binding Progress}" ShowError="{Binding HasFailed}" Visibility="{Binding Completed, Converter={StaticResource BoolToObjectConverter}}" />
                        <TextBlock x:Uid="TaskManagerPage_UploadCompleted" Visibility="{Binding Completed, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <StackPanel Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock x:Uid="TaskManagerPage_UploadFailed" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>

                    <!--上传功能按钮-->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10 0 10 0">
                        <Button Margin="0 0 10 0" Visibility="{Binding IsUploading, Converter={StaticResource BoolToVisibilityConverter}}" Command="{Binding PauseUploadCommand}" >
                            <FontIcon Glyph="&#xE769;" FontSize="10" />
                        </Button>

                        <Button Command="{Binding CancelTaskCommand}">
                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                        </Button>
                    </StackPanel>
                    
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Pivot x:Uid="TaskManagerPage_Pivot_Title">
            <PivotItem x:Uid="TaskManagerPage_Pivot_Download">
                <ListView ItemsSource="{Binding DownloadTasks}" ItemTemplate="{StaticResource DownloadTaskTemplate}"/>
            </PivotItem>
            <PivotItem x:Uid="TaskManagerPage_Pivot_Upload">
                <ListView ItemsSource="{Binding UploadTasks}" ItemTemplate="{StaticResource UploadTaskTemplate}" />
            </PivotItem>
            <PivotItem x:Uid="Sync_Transfers">
                <ListView ItemsSource="{x:Bind FolderSync.Bindings}" SelectionMode="None" HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="8" Padding="12">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{Binding State}" />
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                <ProgressBar Value="{Binding Percent}" />
                                <TextBlock Text="{Binding LastSuccess}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" />
                                    <Button x:Uid="Sync_CheckNow" Command="{Binding CheckNowCommand}" IsEnabled="{Binding Enabled}" />
                                </StackPanel>
                                <InfoBar IsOpen="{Binding HasIssues}" Message="{Binding Issues}" Severity="Warning" IsClosable="False" />
                                <TextBlock Text="{Binding CommandError}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>

        <!--为什么不使用AppSDK1.5 SelectBar呢？因为SettingsControls Nuget包与其不兼容，降级或者替换类似组件，所以等待修复吧-->
        <!--<SelectorBar x:Name="SelectorBar1">
                <SelectorBarItem x:Name="SelectorBarItemRecent" Text="Recent" Icon="Clock" />
                <SelectorBarItem x:Name="SelectorBarItemShared" Text="Shared" Icon="Share" />
                <SelectorBarItem x:Name="SelectorBarItemFavorites" Text="Favorites" Icon="Favorite" />
         </SelectorBar>-->

        

    </Grid>
</Page>
