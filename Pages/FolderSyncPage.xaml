<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneDrive_Simple_Management_Tool.Pages.FolderSyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Margin="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Uid="Sync_Title" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Grid.Column="1" x:Uid="Sync_New" HorizontalAlignment="Right" Click="CreateBinding" />
        </Grid>
        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock x:Uid="Sync_Description" TextWrapping="Wrap" />
            <TextBlock x:Uid="Sync_Lifetime" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <InfoBar Grid.Row="2" IsOpen="{Binding HasError}" Message="{Binding ErrorMessage}" Severity="Error" IsClosable="False" />
        <Grid Grid.Row="3">
            <InfoBar IsOpen="{Binding IsEmpty}" x:Uid="Sync_Empty" Severity="Informational" IsClosable="False" VerticalAlignment="Top" />
            <ListView ItemsSource="{Binding Bindings}" SelectionMode="None" HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16" Margin="0,0,0,12" BorderThickness="1" CornerRadius="8"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding State}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding LocalPath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock Text="{Binding RemotePath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <ProgressBar Value="{Binding Percent}" />
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LastSuccess}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleCommand}" />
                                    <Button x:Uid="Sync_CheckNow" Command="{Binding CheckNowCommand}" IsEnabled="{Binding Enabled}" />
                                    <Button x:Uid="Sync_Remove" Click="RemoveBinding" Tag="{Binding}" />
                                </StackPanel>
                                <InfoBar IsOpen="{Binding HasIssues}" x:Uid="Sync_IssueBar" Severity="Warning" IsClosable="False">
                                    <ScrollViewer MaxHeight="200"><TextBlock Text="{Binding Issues}" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></ScrollViewer>
                                </InfoBar>
                                <TextBlock Text="{Binding CommandError}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
