<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneDrive_Simple_Management_Tool.Pages.BookmarkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    Background="Transparent">
    <Page.Resources><converters:BoolToVisibilityConverter x:Key="BoolToVisibility" /></Page.Resources>
    <Grid Padding="24,20,24,24" RowSpacing="12" MaxWidth="1120">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <TextBlock x:Uid="Bookmarks_Title" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Uid="Bookmarks_Description" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="BookmarkSearch" x:Uid="Bookmarks_Search" Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button x:Uid="Bookmarks_Reload" Grid.Column="1" Command="{Binding ReloadCommand}" VerticalAlignment="Bottom" />
        </Grid>
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="{Binding CountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <InfoBar IsOpen="{Binding HasError}" Message="{Binding ErrorMessage}" Severity="Warning" IsClosable="False" />
            <StackPanel Spacing="8" Visibility="{Binding NeedsRecovery, Converter={StaticResource BoolToVisibility}}">
                <Button x:Uid="Bookmarks_Restore" Command="{Binding RestoreBackupCommand}" />
                <Button x:Uid="Bookmarks_Rebuild" Click="Rebuild" IsEnabled="{Binding CanRecoverBookmarks}" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="3">
            <StackPanel Spacing="12" Padding="20" VerticalAlignment="Top" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock x:Uid="Bookmarks_EmptyTitle" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Uid="Bookmarks_Empty" TextWrapping="Wrap" />
                <Button x:Uid="Bookmarks_Files" Click="OpenFiles" />
            </StackPanel>
            <TextBlock x:Uid="Bookmarks_NoMatches" TextWrapping="Wrap" Margin="20" Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />
            <ListView x:Name="BookmarkList" ItemsSource="{Binding Items}" IsEnabled="{Binding CanUseItems}" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}" SelectionMode="Single" KeyDown="OnListKeyDown">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DriveName}" TextWrapping="Wrap" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Kind}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding AddedText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button x:Uid="Bookmarks_Open" Click="OpenBookmark" />
                                    <Button x:Uid="Bookmarks_RemoveButton" Click="RemoveBookmark" />
                                </StackPanel>
                                <InfoBar IsOpen="{Binding HasError}" Message="{Binding ErrorMessage}" Severity="Warning" IsClosable="False" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
