<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneDrive_Simple_Management_Tool.Pages.BookmarkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    xmlns:localControls="using:OneDrive_Simple_Management_Tool.Controls"
    Background="Transparent">
    <Page.Resources><converters:BoolToVisibilityConverter x:Key="BoolToVisibility" /></Page.Resources>
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FocusSearch" />
        <KeyboardAccelerator Key="F5" Invoked="RefreshBookmarks" />
    </Page.KeyboardAccelerators>
    <Grid Padding="24,20,24,24" MaxWidth="1120">
        <ListView x:Name="BookmarkList" ItemsSource="{Binding Items}" HorizontalContentAlignment="Stretch"
                  SelectionMode="Single" KeyDown="OnListKeyDown">
            <ListView.Header>
                <StackPanel Spacing="12" Padding="0,0,0,16">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Bookmarks_Title" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Uid="Bookmarks_Description" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="BookmarkSearch" x:Uid="Bookmarks_Search" Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Uid="Bookmarks_Reload" Grid.Column="1" Command="{Binding ReloadCommand}" VerticalAlignment="Bottom" />
                    </Grid>
                    <TextBlock Text="{Binding CountText}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <InfoBar IsOpen="{Binding HasError}" Message="{Binding ErrorMessage}" Severity="Warning" IsClosable="False" />
                    <StackPanel Spacing="8" Visibility="{Binding NeedsRecovery, Converter={StaticResource BoolToVisibility}}">
                        <Button x:Uid="Bookmarks_Restore" Command="{Binding RestoreBackupCommand}" />
                        <Button x:Uid="Bookmarks_Rebuild" Click="Rebuild" IsEnabled="{Binding CanRecoverBookmarks}" />
                    </StackPanel>
                    <StackPanel Spacing="12" Padding="20" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock x:Uid="Bookmarks_EmptyTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Uid="Bookmarks_Empty" TextWrapping="Wrap" />
                        <Button x:Uid="Bookmarks_Files" Click="OpenFiles" />
                    </StackPanel>
                    <TextBlock x:Uid="Bookmarks_NoMatches" TextWrapping="Wrap" Margin="20" Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ListView.Header>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,10" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DriveName}" TextWrapping="Wrap" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Kind}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding AddedText}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <localControls:WrapPanel Margin="0,4,0,0">
                                <Button x:Uid="Bookmarks_Open" Click="OpenBookmark" Margin="0,0,8,4" IsEnabled="{Binding Owner.CanUseItems}" />
                                <Button x:Uid="Bookmarks_RemoveButton" Click="RemoveBookmark" Margin="0,0,0,4" IsEnabled="{Binding Owner.CanUseItems}" />
                            </localControls:WrapPanel>
                            <InfoBar IsOpen="{Binding HasError}" Message="{Binding ErrorMessage}" Severity="Warning" IsClosable="False" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
