<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneDrive_Simple_Management_Tool.Pages.DrivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OneDrive_Simple_Management_Tool.Models"
    xmlns:views="using:OneDrive_Simple_Management_Tool.Views.Layout"
    Background="Transparent"
    NavigationCacheMode="Enabled" KeyboardAcceleratorPlacementMode="Hidden">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Invoked="OnFileAccelerator" />
        <KeyboardAccelerator Key="F2" Invoked="OnFileAccelerator" />
        <KeyboardAccelerator Key="Delete" Invoked="OnFileAccelerator" />
        <KeyboardAccelerator Modifiers="Menu" Key="Enter" Invoked="OnFileAccelerator" />
        <KeyboardAccelerator Key="F5" Invoked="OnFileAccelerator" />
        <KeyboardAccelerator Modifiers="Control,Shift" Key="N" Invoked="OnFileAccelerator" />
        <KeyboardAccelerator Key="Back" Invoked="OnFileAccelerator" />
        <KeyboardAccelerator Modifiers="Menu" Key="Left" Invoked="OnFileAccelerator" />
    </Page.KeyboardAccelerators>
    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading}" />
        <Grid Grid.Row="1" Margin="24,12,24,4" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Uid="Drive_Back" Click="BackToDrives" VerticalAlignment="Center"><FontIcon Glyph="&#xE72B;" FontSize="16" /></Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <BreadcrumbBar x:Name="BreadcrumbBar" ItemsSource="{Binding BreadcrumbItems}" ItemClicked="BreadcrumbBar_ItemClicked">
                    <BreadcrumbBar.ItemTemplate>
                        <DataTemplate x:DataType="models:BreadcrumbItem">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </BreadcrumbBar.ItemTemplate>
                </BreadcrumbBar>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Uid="Sync_BindCurrent" Click="BindCurrentFolder" IsEnabled="{Binding CanCreateHere}"><SymbolIcon Symbol="Sync" /></Button>
                <Button x:Uid="Drive_Search" Click="ShowSearchDialogAsync"><SymbolIcon Symbol="Find" /></Button>
                <Button x:Uid="Drive_Refresh" Command="{Binding RefreshCommand}"><SymbolIcon Symbol="Refresh" /></Button>
                <Button x:Uid="Drive_Layout">
                    <SymbolIcon Symbol="ViewAll" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Uid="CloudPage_Layout_Column" Tag="List" Click="ChangeLayout" />
                            <MenuFlyoutItem x:Uid="CloudPage_Layout_Grid" Tag="Grid" Click="ChangeLayout" />
                            <MenuFlyoutItem x:Uid="CloudPage_Layout_Image" IsEnabled="False" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Margin="24,0">
            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,0,4" Visibility="{Binding SearchVisibility}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding SearchDescription}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Grid.Column="2" x:Uid="Drive_ClearSearch" Command="{Binding ClearSearchCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Grid ColumnSpacing="8" Margin="0,4" MinHeight="32">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="1" x:Uid="Drive_CancelLoading" Command="{Binding CancelLoadingCommand}" Visibility="{Binding IsLoading}" VerticalAlignment="Center" />
                <Button Grid.Column="2" x:Uid="Drive_RetryLoading" Command="{Binding RetryLoadingCommand}" Visibility="{Binding RetryVisibility}" VerticalAlignment="Center" />
            </Grid>
            <InfoBar x:Uid="FileOperation_ErrorBar" IsOpen="{Binding HasError}"
                     Message="{Binding ErrorMessage}" Severity="Error" IsClosable="False">
                <InfoBar.ActionButton><Button x:Uid="Account_SignInButton" Command="{Binding SignInCommand}" /></InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="UploadErrorInfoBar" Severity="Error" IsOpen="False" IsClosable="True" />
            <InfoBar Message="{Binding BookmarkMessage}" IsOpen="{Binding HasBookmarkMessage}" Severity="Informational" IsClosable="False" />
        </StackPanel>
        <!-- 8 + the 16 item padding lines rows up with the 24 page gutter. -->
        <Grid Grid.Row="3" x:Name="CloudControl" Background="Transparent" AllowDrop="True" Margin="8,0"
              DragOver="CopyIcon_DragOver" Drop="ToUpload_Drop">
            <Grid.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem x:Uid="CloudPage_Refresh" Command="{Binding RefreshCommand}" />
                    <MenuFlyoutItem x:Uid="CloudPage_CreateFolder" Click="CreateFolderDialogAsync" IsEnabled="{Binding CanCreateHere}" />
                    <MenuFlyoutSubItem x:Uid="CloudPage_Layout">
                        <MenuFlyoutItem x:Uid="CloudPage_Layout_Column" Tag="List" Click="ChangeLayout" />
                        <MenuFlyoutItem x:Uid="CloudPage_Layout_Grid" Tag="Grid" Click="ChangeLayout" />
                        <MenuFlyoutItem x:Uid="CloudPage_Layout_Image" IsEnabled="False" />
                    </MenuFlyoutSubItem>
                </MenuFlyout>
            </Grid.ContextFlyout>
            <views:ColumnCloudView Visibility="{Binding ListVisibility}" />
            <views:GridCloudView Visibility="{Binding GridVisibility}" />
        </Grid>
    </Grid>
</Page>
