<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OneDrive_Simple_Management_Tool.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.UI.Converters"
    Background="Transparent">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="HomeCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideOverview">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FilesShortcut.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="TasksShortcut.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="TasksShortcut.(Grid.Column)" Value="1" />
                        <Setter Target="SyncShortcut.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="SyncShortcut.(Grid.Column)" Value="2" />
                        <Setter Target="SyncShortcut.(Grid.Row)" Value="0" />
                        <Setter Target="SettingsShortcut.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="SettingsShortcut.(Grid.Column)" Value="3" />
                        <Setter Target="SettingsShortcut.(Grid.Row)" Value="0" />
                        <Setter Target="TransfersCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="SyncCard.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="SyncCard.(Grid.Column)" Value="1" />
                        <Setter Target="SyncCard.(Grid.Row)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer x:Name="HomeScroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel Padding="24,20,24,32" Spacing="16" MaxWidth="1120" HorizontalAlignment="Stretch">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Home_Title" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock x:Uid="Home_Description" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="RefreshHome" x:Uid="Home_Refresh" Grid.Column="1" VerticalAlignment="Center" Command="{Binding RefreshCommand}" />
                </Grid>
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Button x:Name="FilesShortcut" x:Uid="Home_Files" Click="OpenFiles" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" />
                    <Button x:Name="TasksShortcut" x:Uid="Home_Tasks" Click="OpenTasks" Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" />
                    <Button x:Name="SyncShortcut" x:Uid="Home_Sync" Click="OpenSync" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" />
                    <Button x:Name="SettingsShortcut" x:Uid="Home_Settings" Click="OpenSettings" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" />
                </Grid>
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border x:Name="TransfersCard" Grid.ColumnSpan="2" Style="{StaticResource HomeCard}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Home_TransfersTitle" FontSize="18" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock x:Name="ActiveTransferCount" Text="{Binding ActiveTransfers}" FontSize="36" FontWeight="SemiBold" />
                                <TextBlock x:Uid="Home_ActiveTransfers" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding TransferSummary}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="Home_TransferScope" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Uid="Home_NoTransfers" TextWrapping="Wrap" Visibility="{Binding HasNoTransfers, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="SyncCard" Grid.ColumnSpan="2" Grid.Row="1" Style="{StaticResource HomeCard}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="Home_SyncTitle" FontSize="18" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding SyncCount}" FontSize="36" FontWeight="SemiBold" />
                                <TextBlock x:Uid="Home_SyncFolders" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding SyncSummary}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="Home_NoSyncs" TextWrapping="Wrap" Visibility="{Binding HasNoSyncs, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <InfoBar IsOpen="{Binding HasSyncError}" Severity="Warning" IsClosable="False" Message="{Binding SyncErrorMessage}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Spacing="6" Margin="0,8,0,0">
                    <TextBlock x:Uid="Home_DrivesTitle" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LastRefreshed}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
                <InfoBar IsOpen="{Binding HasError}" Severity="Warning" IsClosable="False" Message="{Binding ErrorMessage}">
                    <InfoBar.ActionButton><Button x:Uid="Home_ManageDrives" Click="OpenFiles" /></InfoBar.ActionButton>
                </InfoBar>
                <Border Style="{StaticResource HomeCard}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="Home_NoDrivesTitle" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Uid="Home_NoDrives" TextWrapping="Wrap" />
                        <Button x:Uid="Home_AddDrive" Click="OpenFiles" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="DriveCards" ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HomeCard}" Margin="0,0,0,12">
                                <StackPanel Spacing="10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Button x:Uid="Home_OpenDrive" Grid.Column="1" Click="OpenDrive" />
                                    </Grid>
                                    <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding CapacityText}" TextWrapping="Wrap" />
                                    <ProgressBar Value="{Binding UsagePercent}" Maximum="100" Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding RemainingText}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <InfoBar IsOpen="{Binding HasError}" Severity="Warning" IsClosable="False" Message="{Binding ErrorMessage}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
