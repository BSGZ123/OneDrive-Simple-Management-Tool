<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OneDrive_Simple_Management_Tool.Views.DeleteFileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="DeleteBatch_Dialog" DefaultButton="Close"
    PrimaryButtonText="{Binding SubmitText}"
    IsPrimaryButtonEnabled="{Binding CanSubmit}">
    <StackPanel Spacing="12" MinWidth="320">
        <TextBlock Text="{Binding Question}" TextWrapping="Wrap" MaxWidth="440" />
        <CheckBox x:Uid="DeleteFile_Permanent" IsEnabled="{Binding CanChooseDeleteMode}" IsChecked="{Binding PermanentDelete, Mode=TwoWay}" />
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
        <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="2" Margin="0,4" MaxWidth="440">
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Status}" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24" HorizontalAlignment="Left" />
        <InfoBar IsOpen="{Binding HasError}" Message="{Binding ErrorMessage}" Severity="Error" IsClosable="False" />
    </StackPanel>
</ContentDialog>
