<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OneDrive_Simple_Management_Tool.Views.DeleteFileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="DeleteFile_Dialog" DefaultButton="Close"
    IsPrimaryButtonEnabled="{Binding CanSubmit}">
    <StackPanel Spacing="12" MinWidth="320">
        <TextBlock x:Uid="DeleteFile_Question" />
        <TextBlock Text="{Binding File.Name}" TextWrapping="Wrap" MaxWidth="440" />
        <CheckBox x:Uid="DeleteFile_Permanent" IsEnabled="{Binding CanEdit}" IsChecked="{Binding PermanentDelete, Mode=TwoWay}" />
        <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24" HorizontalAlignment="Left" />
        <InfoBar IsOpen="{Binding HasError}" Message="{Binding ErrorMessage}" Severity="Error" IsClosable="False" />
    </StackPanel>
</ContentDialog>
