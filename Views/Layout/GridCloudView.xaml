<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OneDrive_Simple_Management_Tool.Views.Layout.GridCloudView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:OneDrive_Simple_Management_Tool.Views.Layout">
    <GridView ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" SelectionMode="Single">
        <GridView.ItemTemplate>
            <DataTemplate><views:GirdFileView /></DataTemplate>
        </GridView.ItemTemplate>
    </GridView>
</UserControl>