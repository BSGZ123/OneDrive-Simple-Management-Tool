<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OneDrive_Simple_Management_Tool.Views.ConvertFileFormatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="FileConvert_Dialog">
    <StackPanel Spacing="12" MinWidth="360" MaxWidth="560">
        <TextBlock x:Uid="FileConvert_Description" TextWrapping="Wrap" />
        <TextBlock Text="{Binding FormattedExtensions}" TextWrapping="Wrap" />
        <Button x:Uid="FileConvert_Save" Command="{Binding ConvertFileFormatCommand}" />
        <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding SavedFilePath}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        <InfoBar IsOpen="{Binding HasError}" Message="{Binding ErrorMessage}" Severity="Error" IsClosable="False" />
    </StackPanel>
</ContentDialog>