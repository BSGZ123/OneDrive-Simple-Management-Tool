<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OneDrive_Simple_Management_Tool.Views.RenameFileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="RenameFile_Dialog" DefaultButton="Primary"
    IsPrimaryButtonEnabled="{Binding CanSubmit}">
    <StackPanel Spacing="12" MinWidth="320">
        <TextBox x:Uid="RenameFile_Name" IsEnabled="{Binding CanEdit}" Text="{Binding FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock x:Uid="FileOperation_NameHint" TextWrapping="Wrap" MaxWidth="440" />
        <ProgressRing IsActive="{Binding IsBusy}" Width="24" Height="24" HorizontalAlignment="Left" />
        <InfoBar IsOpen="{Binding HasError}" Message="{Binding ErrorMessage}" Severity="Error" IsClosable="False" />
    </StackPanel>
</ContentDialog>
